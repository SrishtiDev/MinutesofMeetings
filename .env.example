# ---------------------------------------------------------------------------
# LLM provider (Groq free tier — OpenAI-compatible)
# ---------------------------------------------------------------------------

# Primary key lookup order: LLM_API_KEY → GROQ_API_KEY → OPENAI_API_KEY
GROQ_API_KEY=your-groq-api-key-here

# Optional overrides (defaults shown below point at Groq)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Speech-to-text (for transcriber.py — not used by extractor.py directly)
# ---------------------------------------------------------------------------
STT_MODEL=whisper-large-v3
